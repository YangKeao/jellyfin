+    const videoStream = mediaSource.MediaStreams.filter(function (stream) {
         return stream.Type === 'Video';
     })[0];
 
@@ -17,6 +41,7 @@ function showQualityMenu(player, btn) {
         isAutomaticBitrateEnabled: playbackManager.enableAutomaticBitrateDetection(player),
         videoCodec,
         videoBitRate,
+        maxSelectableBitrate: getAnime4KMaxBitrate(mediaSource),
         enableAuto: true
     });
 
@@ -89,7 +114,8 @@ function showRepeatModeMenu(player, btn) {
 function getQualitySecondaryText(player) {
