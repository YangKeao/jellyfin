@@ -4,8 +4,32 @@ import globalize from 'lib/globalize';
 import { ServerConnections } from 'lib/jellyfin-apiclient';
 import qualityoptions from '../qualityOptions';
 
+function getAnime4KMaxBitrate(mediaSource) {
+    const transcodingUrl = mediaSource?.TranscodingUrl;
+    if (!transcodingUrl) {
+        return null;
+    }
+
+    const query = transcodingUrl.includes('?') ? transcodingUrl.split('?')[1] : '';
+    const values = {};
+    for (const part of query.split('&')) {
+        const separator = part.indexOf('=');
+        if (separator > 0) {
+            values[decodeURIComponent(part.slice(0, separator))] = decodeURIComponent(part.slice(separator + 1));
+        }
+    }
+
+    if (values.anime4k !== 'true') {
+        return null;
+    }
+
+    const maxBitrate = Number(values.anime4kMaxBitrate);
+    return Number.isFinite(maxBitrate) && maxBitrate > 0 ? maxBitrate : null;
+}
