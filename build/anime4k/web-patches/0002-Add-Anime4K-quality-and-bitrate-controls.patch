diff --git a/src/components/qualityOptions.test.js b/src/components/qualityOptions.test.js
new file mode 100644
index 0000000..aeb5403
--- /dev/null
+++ b/src/components/qualityOptions.test.js
@@ -0,0 +1,53 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import { getVideoQualityOptions } from './qualityOptions';
+
+vi.mock('../lib/globalize', () => ({
+    default: {
+        translate: key => key
+    }
+}));
+
+describe('getVideoQualityOptions', () => {
+    it('keeps normal playback options limited by the source bitrate', () => {
+        const options = getVideoQualityOptions({
+            currentMaxBitrate: 120_000_000,
+            isAutomaticBitrateEnabled: true,
+            videoCodec: 'h264',
+            videoBitRate: 4_000_000,
+            enableAuto: true
+        });
+
+        expect(options.some(option => option.bitrate === 80_000_000)).toBe(false);
+        expect(options.some(option => option.bitrate === 6_000_000)).toBe(true);
+    });
+
+    it('offers Anime4K bitrates up to the configured ceiling', () => {
+        const options = getVideoQualityOptions({
+            currentMaxBitrate: 120_000_000,
+            isAutomaticBitrateEnabled: true,
+            videoCodec: 'h264',
+            videoBitRate: 4_000_000,
+            maxSelectableBitrate: 80_000_000,
+            enableAuto: true
+        });
+
+        expect(options.some(option => option.bitrate === 120_000_000)).toBe(false);
+        expect(options.some(option => option.bitrate === 80_000_000)).toBe(true);
+        expect(options[0]).toMatchObject({ bitrate: 0, selected: true, autoText: '80 Mbps' });
+    });
+
+    it('adds a custom ceiling and preserves a manual lower limit', () => {
+        const options = getVideoQualityOptions({
+            currentMaxBitrate: 20_000_000,
+            isAutomaticBitrateEnabled: false,
+            videoCodec: 'h264',
+            videoBitRate: 4_000_000,
+            maxSelectableBitrate: 100_000_000,
+            enableAuto: true
+        });
+
+        expect(options.some(option => option.name === '100 Mbps' && option.bitrate === 100_000_000)).toBe(true);
+        expect(options.find(option => option.bitrate === 20_000_000)?.selected).toBe(true);
+    });
+});
