From d1832e7bf62c44fd4a51c2480db1665c1a81c1cc Mon Sep 17 00:00:00 2001
From: Yang Keao <yangkeao@chunibyo.icu>
Date: Tue, 25 Aug 2026 01:01:52 +0800
Subject: [PATCH] Add Anime4K transcoding controls

---
 .../dashboard/routes/playback/transcoding.tsx | 58 ++++++++++++++++++-
 src/strings/en-us.json                        |  3 +
 src/strings/zh-cn.json                        |  3 +
 3 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/src/apps/dashboard/routes/playback/transcoding.tsx b/src/apps/dashboard/routes/playback/transcoding.tsx
index 482b34b..d774a6e 100644
--- a/src/apps/dashboard/routes/playback/transcoding.tsx
+++ b/src/apps/dashboard/routes/playback/transcoding.tsx
@@ -32,6 +32,20 @@ import SimpleAlert from 'components/SimpleAlert';
 
 const CONFIG_KEY = 'encoding';
 
+type Anime4KEncodingOptions = EncodingOptions & {
+    EnableAnime4K?: boolean;
+};
+
+interface Anime4KStatus {
+    Configured: boolean;
+    Available: boolean;
+    Effective: boolean;
+    Profile: string;
+    ShaderVersion: string;
+    Target: string;
+    Reason: string;
+}
+
 export const action = async ({ request }: ActionFunctionArgs) => {
     const api = ServerConnections.getCurrentApi();
     if (!api) throw new Error('No Api instance available');
@@ -51,8 +65,9 @@ export const action = async ({ request }: ActionFunctionArgs) => {
 };
 
 export const Component = () => {
-    const { data: initialConfig, isPending, isError } = useNamedConfiguration<EncodingOptions>(CONFIG_KEY);
-    const [ config, setConfig ] = useState<EncodingOptions | null>(null);
+    const { data: initialConfig, isPending, isError } = useNamedConfiguration<Anime4KEncodingOptions>(CONFIG_KEY);
+    const [ config, setConfig ] = useState<Anime4KEncodingOptions | null>(null);
+    const [ anime4KStatus, setAnime4KStatus ] = useState<Anime4KStatus | null>(null);
     const navigation = useNavigation();
     const actionData = useActionData() as ActionData | undefined;
     const submit = useSubmit();
@@ -65,6 +80,25 @@ export const Component = () => {
         }
     }, [ initialConfig, config ]);
 
+    useEffect(() => {
+        const api = ServerConnections.getCurrentApi();
+        if (!api) return;
+
+        let active = true;
+        void api.axiosInstance
+            .get<Anime4KStatus>('/System/Anime4K/Status')
+            .then(response => {
+                if (active) setAnime4KStatus(response.data);
+            })
+            .catch(() => {
+                if (active) setAnime4KStatus(null);
+            });
+
+        return () => {
+            active = false;
+        };
+    }, [ initialConfig ]);
+
     const onConfigChange = useCallback((e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
         setConfig({
             ...config,
@@ -183,6 +217,26 @@ export const Component = () => {
                                 </Alert>
                             )}
 
+                            <FormControl variant='standard'>
+                                <Typography variant='h3'>{globalize.translate('Anime4KUpscaling')}</Typography>
+                                <FormControlLabel
+                                    label={globalize.translate('EnableAnime4K')}
+                                    control={
+                                        <Checkbox
+                                            name='EnableAnime4K'
+                                            checked={config.EnableAnime4K ?? false}
+                                            onChange={onCheckboxChange}
+                                        />
+                                    }
+                                />
+                                <FormHelperText>{globalize.translate('EnableAnime4KHelp')}</FormHelperText>
+                                {anime4KStatus && (
+                                    <Alert severity={anime4KStatus.Effective ? 'success' : (config.EnableAnime4K ? 'warning' : 'info')}>
+                                        {anime4KStatus.Reason} ({anime4KStatus.Profile}, {anime4KStatus.Target}, Anime4K {anime4KStatus.ShaderVersion})
+                                    </Alert>
+                                )}
+                            </FormControl>
+
                             <TextField
                                 name='HardwareAccelerationType'
                                 select
